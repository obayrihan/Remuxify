<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Remuxify.Plugin</AssemblyName>
    <RootNamespace>Remuxify.Plugin</RootNamespace>
    <Version>0.2.0</Version>
    <JellyfinVersion Condition="'$(TargetFramework)' == 'net9.0'">10.11.8</JellyfinVersion>
    <JellyfinVersion Condition="'$(TargetFramework)' == 'net10.0'">12.4.0</JellyfinVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/configPage.html" />
    <EmbeddedResource Include="../../static/*" LogicalName="Remuxify.Plugin.Dashboard.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
